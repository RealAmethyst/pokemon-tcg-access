<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PokemonTCGLiveAccessibility</AssemblyName>
    <RootNamespace>PokemonTCGLiveAccessibility</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- The Updater\ subfolder is its own MelonLoader mod (separate process, separate assemblies);
       it's built via Updater\PokemonTCGLiveUpdaterAccessibility.csproj. Keep its sources out of the
       main mod's default-compile glob. -->
  <ItemGroup>
    <Compile Remove="Updater\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.0" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity engine modules -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MatchLogic">
      <HintPath>$(GameManagedDir)\MatchLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CardDatabase.DataAccess">
      <HintPath>$(GameManagedDir)\CardDatabase.DataAccess.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RainierClientSDK">
      <HintPath>$(GameManagedDir)\RainierClientSDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCI.RainierClient">
      <HintPath>$(GameManagedDir)\TPCI.RainierClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCI.Shared.Singletons">
      <HintPath>$(GameManagedDir)\TPCI.Shared.Singletons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCILocalization">
      <HintPath>$(GameManagedDir)\TPCILocalization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCILocalizationAPI">
      <HintPath>$(GameManagedDir)\TPCILocalizationAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCI.Localization.Api">
      <HintPath>$(GameManagedDir)\TPCI.Localization.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCI.Localization.Impl">
      <HintPath>$(GameManagedDir)\TPCI.Localization.Impl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCIEventDispatch">
      <HintPath>$(GameManagedDir)\TPCIEventDispatch.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCIEventDispatchAPI">
      <HintPath>$(GameManagedDir)\TPCIEventDispatchAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TPCIAnywhereCoroutine">
      <HintPath>$(GameManagedDir)\TPCIAnywhereCoroutine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharedLogicUtils">
      <HintPath>$(GameManagedDir)\SharedLogicUtils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Aug 2026 client update split ItemData / CurrencyType / ItemCost / ItemGrant out of
         SharedLogicUtils.dll into RainierItems.dll (same SharedLogicUtils.source.DataTypes
         namespace). Without this reference those types fail to resolve and every method that
         touches them dies with TypeLoadException at JIT time (silent labels, hard crashes). -->
    <Reference Include="RainierItems">
      <HintPath>$(GameManagedDir)\RainierItems.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ClientNetworking">
      <HintPath>$(GameManagedDir)\ClientNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EnhancedScrollerV2">
      <HintPath>$(GameManagedDir)\EnhancedScrollerV2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- DISTRIBUTION-ONLY obfuscation. Opt-in: runs ONLY when built as `dotnet build -c Release
       -p:Obfuscate=true`. A plain `dotnet build -c Release` (what we develop, deploy and test with)
       is completely untouched, so dev builds and their logs stay readable. The protected DLL is
       written to bin\Obfuscated\ (NOT bin\Release\), so the normal deploy never picks it up by
       accident — the packaging step points at bin\Obfuscated\. Symbols: this same flag drops the
       .pdb and optimizes, so nothing debuggable ships. See obfuscar.xml and build\verify-obfuscation.ps1.
       Needs the Obfuscar global tool once (install command in obfuscar.xml / the recommendations doc). -->
  <PropertyGroup Condition="'$(Obfuscate)' == 'true' and '$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Clear the shipping + staging folders BEFORE the compiler runs, so a compile failure (which skips
       the AfterTargets publish step below) can never leave a stale protected DLL in bin\Obfuscated for
       the packager to grab. Hooks CoreCompile, not Build: Build's compile DEPENDENCY runs before a
       BeforeTargets="Build" hook, so that fired too late (proven). A protected artifact therefore only
       ever exists after a fully successful build. -->
  <Target Name="ProtectedBuildClean" BeforeTargets="CoreCompile"
          Condition="'$(Obfuscate)' == 'true' and '$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\Obfuscated;$(MSBuildProjectDirectory)\bin\ObfuscatedStaging" />
  </Target>

  <Target Name="ObfuscateRelease" AfterTargets="Build"
          Condition="'$(Obfuscate)' == 'true' and '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ObfStage>$(MSBuildProjectDirectory)\bin\ObfuscatedStaging</_ObfStage>
      <_ObfOut>$(MSBuildProjectDirectory)\bin\Obfuscated</_ObfOut>
    </PropertyGroup>
    <!-- Also clear here: on an up-to-date incremental build CoreCompile is skipped, so the pre-compile
         clean above doesn't fire, but this target still does - always start from an empty slate. -->
    <RemoveDir Directories="$(_ObfOut);$(_ObfStage)" />
    <MakeDir Directories="$(_ObfStage)" />
    <Message Importance="high" Text="Obfuscating distribution build (symbol renaming, types/methods/fields) into staging..." />
    <Exec Command="obfuscar.console &quot;obfuscar.xml&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Fail closed: verify the STAGING output. A non-zero exit fails the build here, so the publish
         step below never runs and bin\Obfuscated stays empty. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;build\verify-obfuscation.ps1&quot; &quot;$(_ObfStage)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Verified good: publish the DLL + its de-obfuscation mapping to the shipping location. -->
    <MakeDir Directories="$(_ObfOut)" />
    <Copy SourceFiles="$(_ObfStage)\PokemonTCGLiveAccessibility.dll;$(_ObfStage)\Mapping.txt" DestinationFolder="$(_ObfOut)" />
    <Message Importance="high" Text="Protected DLL ready: $(_ObfOut)\PokemonTCGLiveAccessibility.dll (keep its Mapping.txt to de-obfuscate crash logs)" />
  </Target>

</Project>
